def wysokosc_trojkata(a: float, b: float, c: float) -> float:
    if a < b+c and b < a+c and c < a+b:
        return a*3**0.5/2
    else:
        return 0


def przekatna_kwadratu(a: float, b: float, c: float) -> float:
    if a < b+c and b < a+c and c < a+b:
        return a*2**0.5
    else:
        return 0


def pitagoras(a: float, b: float, c: float) -> float:
    if a < b+c and b < a+c and c < a+b:
        return (a**2+b**2)**0.5
    else:
        return 0


