from random import randint



# 1. Wygeneruj tablicę zawierającą n losowych elementów. Z zakresem min i max.
n = 10
x = []
for _ in range(n):
    x.append(randint(1, 10))
print(f"1. Wygenerowana tablica: {x}")


# 2. Napisz program (nie max, min) znajdujący max i min wartość. Tablica zawiera 1,1,1,5,5,-2,10,1
x = [1, 1, 1, 5, 5, -2, 10, 1]
minimum = x[0]
maximum = x[0]
for el in x:
    if el < minimum:
        minimum = el
    if el > maximum:
        maximum = el
print(f"2. Tablica: {x} | Min: {minimum}, Max: {maximum}")


# 3. Napisz program, który powie ile razy powtórzył się n element na tablicy.
szukany = 1
licznik = 0
for el in x:
    if el == szukany:
        licznik += 1
print(f"3. Element {szukany} powtórzył się {licznik} razy.")


# 4. Sprawdź ile liczb podzielnych przez n zawiera ta tablica.
dzielnik = 2
ile_podzielnych = 0
for el in x:
    if el % dzielnik == 0:
        ile_podzielnych += 1
print(f"4. Liczb podzielnych przez {dzielnik}: {ile_podzielnych}")


