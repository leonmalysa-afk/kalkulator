from random import randint

def x1()->list:
    x = []
    for _ in range(3):
        x.append(randint(1,100))
    return x

def x2(n:int)->list[list]:
    x = []
    for _ in range(n):
        x.append(x1())
    return x

x = x2(100)
print(x)

def czy_to_jest_tr(a:float,b:float,c:float):
    x = [a,b,c]
    x.sort()
    a,b,c = x
    if a + b > c:
        return True
    return False

def ile_tr(lst:list[list])->int:
    ile = 0
    for el in lst:
        a,b,c = el
        if czy_to_jest_tr(a,b,c):
            ile += 1
        return ile

def czy_to_jest_tr_pr(a:float,b:float,c:float)->bool:
    x = [a,b,c]
    x.sort()
    a,b,c = x
    if a**2 + b**2 == c**2:
        return True
    return False

def ile_tr_pr(lst:list[list])->int:
    ile = 0
    for el in lst:
        a,b,c = el
        if czy_to_jest_tr_pr(a,b,c):    
            ile += 1
        return ile
    
print(ile_tr(x))
print(ile_tr_pr(x))




