from random import randint
print(" Zgadnij liczbę od 1 do 10 ")

k1 = randint(1, 10)
ile1 = 0

while True:
    ile1 += 1
    inp = int(input("Czy to: "))

    if inp == k1:
        print(f"Brawo! Zgadłeś szukaną liczbę {k1}!")
        print(f"Zgadłeś w {ile1} próbach.\n")
        break
    else:
        print("Zła liczba, spróbuj ponownie!")


print(" Zgadnij liczbę od 1 do 1000 ")
k2 = randint(1, 1000)
ile2 = 0

while True:
    ile2 += 1
    inp = int(input("Czy to: "))

