        print(f"Brawo! Zgadłeś szukaną liczbę {k2}!")
        print(f"Zgadłeś w {ile2} próbach.")
        break
    elif inp < k2:
        print("Szukana liczba jest WIĘKSZA!")
    else:
        print("Szukana liczba jest MNIEJSZA!")
